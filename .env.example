# Copy to .env and adjust before `docker compose up`.

# Postgres credentials (used by the db service)
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mtg_arena

# Prisma connection string. Inside docker compose the host is `db`;
# for local development against the compose db use `localhost`.
DATABASE_URL=postgresql://arena:change-me@db:5432/mtg_arena?schema=public
